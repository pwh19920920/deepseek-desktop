{
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "identifier": "ai.deepseek.harness-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/dsh"
    ]
  }
}