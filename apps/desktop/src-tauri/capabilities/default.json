{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the desktop app",
  "windows": ["main"],
  "permissions": [
    "shell:allow-execute",
    "shell:allow-kill",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}
